# backend-python (Career Hub API) environment variables.
# Copy to `.env` for local development (never commit real secrets).

# Your Anthropic API key. Server-side only — never exposed to the frontend.
ANTHROPIC_API_KEY=

# Model to use. Defaults to claude-haiku-4-5 if unset.
ANTHROPIC_MODEL=claude-haiku-4-5

# Request timeout (seconds) for calls to the Anthropic API.
ANTHROPIC_TIMEOUT=30

# Your Supabase project URL, e.g. https://your-project-ref.supabase.co
# Coach access tokens are verified against this project's public JWKS
# (<SUPABASE_URL>/auth/v1/.well-known/jwks.json), and their issuer must contain
# this value. No shared JWT secret is needed.
SUPABASE_URL=

# Supabase service role key (Project Settings → API). Server-side ONLY — never
# expose to the frontend. Used to load/update outreach drafts when sending.
SUPABASE_SERVICE_ROLE_KEY=

# Resend (https://resend.com) sends the outreach email over HTTPS. Railway
# blocks outbound SMTP below the Pro plan, so port 443 is the only way out.
RESEND_API_KEY=

# Sender address, e.g. "Violet Dao <violet@cvadvance.com>". Its domain must be
# verified in Resend (Domains → Add Domain, then add the DNS records shown).
# Before verifying, `onboarding@resend.dev` works for testing the path.
EMAIL_FROM=

# Adzuna API (https://developer.adzuna.com/)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Reed API (https://www.reed.co.uk/developers)
REED_API_KEY=

# Comma-separated list of allowed CORS origins (your frontend).
# e.g. https://your-app.vercel.app,http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# Optional regex for additional CORS origins, on top of ALLOWED_ORIGINS. Vercel
# preview URLs carry a per-deploy hash, so they cannot be listed one by one.
# Matched in full, so anchor it to your own Vercel scope — never a bare
# `.*\.vercel\.app`, which would let any Vercel app call this API.
# e.g. https://your-app-[a-z0-9-]+-your-scope\.vercel\.app
# Leave empty to disable.
ALLOWED_ORIGIN_REGEX=

# Comma-separated Supabase user ids that count as coaches regardless of the
# users.is_admin column. Mirrors the Node backend's ADMIN_USER_IDS. This is the
# bootstrap path: it works before anyone has the flag set, and it is the way
# back in if the flag is ever mis-set. Empty = nobody is allowlisted (the flag
# is then the only route in).
ADMIN_USER_IDS=

# How long a coach/not-coach answer is cached, in seconds. Matches the Node
# backend's 60s. Lower it if you need a revoked coach to lose access faster.
ROLE_CACHE_TTL_SECONDS=60

# Model for sponsor entity resolution. Defaults to claude-haiku-4-5 like every
# other call. Haiku 4.5 rejects output_config.effort, so the resolver sends none.
SPONSOR_RESOLVER_MODEL=claude-haiku-4-5
