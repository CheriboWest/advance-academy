{
  "name": "backend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json --incremental false",
    "start": "tsx src/main.ts",
    "start:prod": "node dist/main.js",
    "start:dev": "tsx watch src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "check:companies-house": "tsx scripts/check-companies-house.ts",
    "research:company": "tsx scripts/research-company.ts",
    "context:check": "tsx scripts/context-readiness.ts",
    "generate:pack": "tsx scripts/generate-pack.ts",
    "usage": "tsx scripts/usage-report.ts",
    "usage:week": "tsx scripts/usage-report.ts -- --days 7",
    "usage:month": "tsx scripts/usage-report.ts -- --days 30"
  },
  "dependencies": {
    "@advance-academy/contracts": "*",
    "@anthropic-ai/sdk": "^0.82.0",
    "@fastify/cors": "^11.1.0",
    "@fastify/multipart": "^9.0.3",
    "@fastify/rate-limit": "^10.3.0",
    "@supabase/supabase-js": "^2.45.0",
    "exa-js": "^2.11.0",
    "fastify": "^5.2.1",
    "mammoth": "^1.9.0",
    "pdf-parse": "^1.1.1",
    "pizzip": "^3.2.0",
    "tsx": "^4.19.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "typescript": "^5.8.3"
  }
}
